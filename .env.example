# Copy to .env and fill in real values. Never commit .env.

# Resend API key (server only — do NOT prefix with VITE_)
RESEND_API_KEY=re_xxxxxxxx

# Verified Resend sender. Test: Idyll Time Wines <onboarding@resend.dev>
RESEND_FROM_EMAIL=Idyll Time Wines <onboarding@resend.dev>

# Comma-separated shop emails that receive each order PDF
ORDER_NOTIFY_EMAILS=siddharthvijaym@gmail.com

# Geoapify Address Autocomplete (browser-safe; free tier)
# https://myprojects.geoapify.com/
VITE_GEOAPIFY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Square (sandbox or production)
# Access token is server-only — do NOT use a VITE_ prefix
SQUARE_ACCESS_TOKEN=EAAA...
SQUARE_LOCATION_ID=LXXXXXXXX
SQUARE_ENVIRONMENT=sandbox
# Browser-safe Web Payments SDK values (must use VITE_ prefix)
VITE_SQUARE_APPLICATION_ID=sandbox-sq0idb-...
VITE_SQUARE_LOCATION_ID=LXXXXXXXX

# Stripe (unused while Square is active — keep if you may switch back)
STRIPE_SECRET_KEY=rk_test_xxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
